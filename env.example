# ===================================
# 美股自选股智能分析系统 - 环境变量配置
# 保存为：.env
# ===================================

# 自选股列表（逗号分隔）
# ✅ 美股示例：AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD,INTC,SPY
# ✅ 指数示例：^GSPC,^IXIC,^DJI,^RUT
# ✅ 港股示例：0700.HK,9988.HK（也可写 0700/9988，yfinance 会自动识别更稳的是带 .HK）
STOCK_LIST=AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD,INTC,SPY

# 数据源配置（A股用到的可留空）
TUSHARE_TOKEN=

# ===================================
# AI 模型配置（二选一，至少配置一个）
# ===================================

# 【方案一】Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
GEMINI_REQUEST_DELAY=2.0

# 【方案二】OpenAI 兼容 API（可选）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# 搜索引擎配置（用于获取股票新闻）
TAVILY_API_KEYS=
SERPAPI_API_KEYS=

# ===================================
# 通知渠道配置（可同时配置多个，全部推送）
# ===================================
# WECHAT_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=
# CUSTOM_WEBHOOK_URLS=
# CUSTOM_WEBHOOK_BEARER_TOKEN=
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=

# 数据库路径
DATABASE_PATH=./data/stock_analysis.db

# === 定时任务配置 ===
SCHEDULE_ENABLED=false
SCHEDULE_TIME=18:00

# 是否启用大盘复盘（true/false）
MARKET_REVIEW_ENABLED=true

# ✅ 大盘复盘市场选择：CN=A股，US=美股
MARKET_REGION=US

# 系统配置
LOG_DIR=./logs
LOG_LEVEL=INFO
MAX_WORKERS=3
DEBUG=false

# ===================================
# WebUI 配置（可选）
# ===================================
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000